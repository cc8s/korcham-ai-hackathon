{
  "name": "oreum-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run test:unit && npm run test:smoke && npm run test:integration && npm run test:submit && npm run test:guard && npm run test:odi-tools",
    "test:unit": "node --import tsx --test test/unit/db.test.ts test/unit/prompts.test.ts test/unit/scenarios.test.ts test/unit/guard.test.ts test/unit/grading.test.ts test/unit/mask.test.ts test/unit/tools.test.ts test/unit/evaluation.test.ts",
    "test:smoke": "node test/smoke.mjs",
    "test:integration": "node test/integration.mjs",
    "test:guard": "node test/guard.mjs",
    "test:submit": "node test/submit.mjs",
    "test:odi-tools": "node test/odi_tools.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.9.0",
    "better-sqlite3": "^12.11.1",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "ws": "^8.23.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.6",
    "@types/node": "^20.17.0",
    "@types/ws": "^8.18.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=20"
  }
}

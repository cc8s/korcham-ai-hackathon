# 서버 .env — 절대 커밋하지 말 것 (.gitignore에 .env 포함)
ANTHROPIC_API_KEY=sk-ant-...
PORT=8787
# 프론트 origin (CORS). 로컬 개발은 Vite 기본 포트
CORS_ORIGIN=http://localhost:5173
# SQLite 파일 경로. Railway는 volume 마운트 경로로
DB_PATH=./data/oreum.db
# 시나리오 폴더. 기본값은 레포 루트의 scenarios/
SCENARIOS_DIR=../scenarios
# 모델
# 평가 에이전트
MODEL_MAIN=claude-opus-5-5
# 팀장 검토 멘트 (판정은 코드)
MODEL_REVIEW=claude-sonnet-5-5
# 오디 (계산 도구로 일하는 AI 비서)
MODEL_ODI=claude-sonnet-5-5
# 팀장 잡담·질문 응답
MODEL_NPC=claude-haiku-5-5
# 이하늘 힌트
MODEL_MENTOR=claude-haiku-5-5

# 공개 링크 비용 방어 (src/guard.ts). 날짜는 한국 시간, 매일 0시 초기화
# 서버 전체 하루 지출 상한 (추정 단가 기준). 넘으면 새 세션·업무·LLM 호출 503
DAILY_BUDGET_USD=20
SESSIONS_PER_IP_DAY=10
RUNS_PER_IP_DAY=10
RUNS_PER_SESSION_DAY=6
NPC_CALLS_PER_RUN=30
# 오디 대화 이력 상한 (넘으면 오래된 주고받기부터 버림)
ODI_HISTORY_CHARS=60000
NPC_HISTORY_CHARS=16000
# Railway 프록시 뒤에서 실제 클라이언트 IP 읽기
TRUST_PROXY=1
